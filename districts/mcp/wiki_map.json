    {"step": "dynamic_sizing", "title": "Dynamic pipe sizing", "done_when": "dynamic_sizing", "optional": true, "wiki": "missing", "rules": ["line_velocity_high", "line_dp_spec_high", "substation_dp_low"]},
    {"step": "representative_periods", "title": "Representative periods", "done_when": "periods", "optional": true, "wiki": "missing", "rules": ["climate_file"]},
    {"step": "cost_optimization", "title": "Cost optimization", "done_when": "cost_optimization", "optional": true, "wiki": "missing",
